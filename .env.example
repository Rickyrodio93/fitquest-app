# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fitquest"

# NextAuth
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Integrazioni wearable
GOOGLE_HEALTH_CLIENT_ID=""
GOOGLE_HEALTH_CLIENT_SECRET=""
# Apple HealthKit non ha una API cloud diretta: richiede un'app companion
# iOS (o un'automazione Apple Shortcuts) che legge i dati localmente e li
# invia al nostro endpoint /api/integrations/apple-health/ingest usando
# un token personale generato da /api/integrations/apple-health/token
# (nessuna variabile d'ambiente necessaria per questa parte)
